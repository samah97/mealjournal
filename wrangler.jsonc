// Cloudflare Workers (static assets only). Build first: `npm run build`.
{
  "name": "mealjournal",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Serve index.html for client-side routes (replaces a `/* /index.html 200` rule,
    // which Workers rejects as an infinite loop).
    "not_found_handling": "single-page-application"
  }
}

# Required: the app needs an account (sign-in, device sync, private share links).
# Without these the app shows a "not set up" screen instead of a sign-in.
# Use the project URL and the *publishable* (or legacy "anon") key from
# Supabase → Project Settings → API Keys. Never put the service-role / secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
